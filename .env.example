ZPRINT_DEMO=true
DATABASE_URL=sqlite:///./data/zprint.db
ZPRINT_DATA_DIR=./data
ZPRINT_ADMIN_KEY=local-demo-admin-change-me
ZPRINT_AGENT_KEY=local-demo-agent-change-me
ZPRINT_WEBHOOK_SECRET=local-demo-webhook-change-me
ZPRINT_STATION=ST001
ZPRINT_API_URL=http://127.0.0.1:8000
ZPRINT_AGENT_DIR=./data/agent
ZPRINT_PRINTER_STATE=READY
# Vercel portal only: set to your persistent backend HTTPS origin, then redeploy.
# Leave unset for a clearly labeled non-functional portal preview.
# ZPRINT_BACKEND_URL=https://your-backend.example
# Hosted backend: use generated, distinct secrets (at least 32 characters).
# ZPRINT_HOSTED=true
# ZPRINT_GATEWAY_KEY=<generated backend gateway key>
# On Vercel, set this to the backend's ZPRINT_GATEWAY_KEY (server-side only):
# ZPRINT_BACKEND_GATEWAY_KEY=<same generated backend gateway key>
